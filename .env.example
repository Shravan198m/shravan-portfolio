# Add these in Vercel → Project → Settings → Environment Variables.
# Never commit a real password or token to Git.
ADMIN_EMAIL=your-admin-email@example.com
ADMIN_PASSWORD=choose-a-long-unique-password
ADMIN_SESSION_SECRET=generate-at-least-32-random-characters
# Created automatically when you connect a Vercel Blob store to this project.
BLOB_READ_WRITE_TOKEN=vercel_blob_rw_placeholder
